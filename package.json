{
  "name": "webpack-v5-chain",
  "version": "2.1.0",
  "description": "A chaining API to generate and simplify webpack 5 configurations.",
  "keywords": [
    "chain",
    "config",
    "webpack"
  ],
  "license": "MPL-2.0",
  "author": {
    "name": "Mister-Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": "https://github.com/Mister-Hope/webpack-v5-chain",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && tsdown",
    "changelog": "conventional-changelog -p conventionalcommits",
    "clean": "rimraf ./dist",
    "dev": "tsdown -w",
    "lint": "cross-env NODE_NO_WARNINGS=1 oxlint --fix && cross-env NODE_NO_WARNINGS=1 oxfmt",
    "lint:check": "cross-env NODE_NO_WARNINGS=1 oxlint && cross-env NODE_NO_WARNINGS=1 oxfmt --check",
    "prepack": "pnpm clean && pnpm build",
    "prepare": "husky",
    "test": "vitest --coverage"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "javascript-stringify": "^2.1.0"
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "2.0.1",
    "@mr-hope/tsconfig": "0.0.4",
    "@mr-hope/verify-commit-message": "0.1.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "cross-env": "^10.1.0",
    "enhanced-resolve": "5.26.0",
    "husky": "9.1.7",
    "nano-staged": "1.0.2",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.74.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "tsdown": "0.23.3",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vitest": "5.0.5",
    "webpack": "5.112.2",
    "webpack-dev-server": "6.1.0"
  },
  "peerDependencies": {
    "webpack": "^5.111.0",
    "webpack-dev-server": "^5.1.0 || ^6.0.0"
  },
  "nano-staged": {
    "**/*": "cross-env NODE_NO_WARNINGS=1 oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts,mts}": "cross-env NODE_NO_WARNINGS=1 oxlint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || ^26.12.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
