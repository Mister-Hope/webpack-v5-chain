{
  "name": "webpack-v5-chain",
  "version": "2.0.0",
  "keywords": [
    "chain",
    "config",
    "webpack"
  ],
  "license": "MPL-2.0",
  "author": {
    "name": "Mister-Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": "https://github.com/Mister-Hope/webpack-v5-chain",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsdown",
    "changelog": "conventional-changelog -p conventionalcommits",
    "clean": "rimraf ./dist",
    "dev": "tsdown -w",
    "lint": "cross-env NODE_NO_WARNINGS=1 oxlint --fix --report-unused-disable-directives --deny-warnings && cross-env NODE_NO_WARNINGS=1 oxfmt",
    "lint:check": "cross-env NODE_NO_WARNINGS=1 oxlint --report-unused-disable-directives --deny-warnings && cross-env NODE_NO_WARNINGS=1 oxfmt --check",
    "prepare": "husky",
    "prepublish": "pnpm clean && pnpm build",
    "test": "vitest --coverage"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "javascript-stringify": "^2.1.0"
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "2.0.1",
    "@mr-hope/tsconfig": "0.0.4",
    "@types/node": "^24.13.3",
    "@types/tapable": "2.3.0",
    "@types/webpack": "5.28.5",
    "@vitest/coverage-istanbul": "4.1.10",
    "conventional-changelog": "8.1.0",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "cross-env": "^10.1.0",
    "enhanced-resolve": "5.24.5",
    "husky": "9.1.7",
    "nano-staged": "1.0.2",
    "oxc-config-hope": "0.3.12",
    "oxfmt": "0.61.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "picocolors": "1.1.1",
    "rimraf": "6.1.3",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vitest": "4.1.10",
    "webpack": "5.109.2",
    "webpack-dev-server": "6.0.0"
  },
  "nano-staged": {
    "**/*": "cross-env NODE_NO_WARNINGS=1 oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts,mts}": "cross-env NODE_NO_WARNINGS=1 oxlint --fix --deny-warnings --report-unused-disable-directives"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.22.0 || ^24.18.0 || ^26.3.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
